# Keys stay here locally or in TrueForge Settings. Never commit .env.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_MODEL=
MODEL_API_KEY=
# Provider name as listed in TrueForge's model catalog (e.g. openai, anthropic, google).
MODEL_PROVIDER=
DAYTONA_API_KEY=
# auto enables a supported local or Daytona sandbox; false disables it.
TRUEFORGE_SANDBOX=auto
MCP_PORT=8791
# Generated by npm run setup if absent; authenticates the private MCP connector.
VERIFYFIRST_MCP_TOKEN=
# Optional hosted TrueForge OIDC ID token:
TRUEFORGE_TOKEN=
