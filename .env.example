# Keys stay here locally or in TrueForge Settings. Never commit .env.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_MODEL=
MODEL_API_KEY=
# Alternative to MODEL_PROVIDER=openai + MODEL_API_KEY:
OPENAI_API_KEY=
# Provider name as listed in TrueForge's model catalog (e.g. openai, anthropic, google).
MODEL_PROVIDER=
DAYTONA_API_KEY=
# auto enables a supported local or Daytona sandbox; false disables it.
TRUEFORGE_SANDBOX=auto
# Native identity/link investigators; false keeps coordinator-only execution.
TRUEFORGE_SUBAGENTS=true
MCP_PORT=8791
# Keep localhost defaults for local use. Compose sets its own private-network values.
MCP_HOST=127.0.0.1
VERIFYFIRST_MCP_URL=http://127.0.0.1:8791/mcp
# Optional private data directory; empty uses ignored .data/.
VERIFYFIRST_DATA_DIR=
# Optional phone reputation. A key file contains only the key, outside this checkout.
IPQS_API_KEY=
IPQS_API_KEY_FILE=
# Generated by npm run setup if absent; authenticates the private MCP connector.
VERIFYFIRST_MCP_TOKEN=
# Optional hosted TrueForge OIDC ID token:
TRUEFORGE_TOKEN=
