# VerifyFirst configuration. Copy to .env and fill in what you need:
#
#     cp .env.example .env
#
# .env is git-ignored. Never commit real credentials.
#
# Every credential below can instead be supplied as a file in ./secrets/ — see
# secrets/README.md. A secret file wins over the matching variable here.
#
# Nothing in this file is required to start the stack. VerifyFirst boots, serves
# the UI and reports any unconfigured integration as "not configured".

# ----------------------------------------------------------------------------
# AI model — required to RUN an investigation, optional to start
# ----------------------------------------------------------------------------
# Leave these blank to add a model in the TrueForge UI instead
# (http://127.0.0.1:8790 -> Settings -> Models). Either route works.
#
# Provider name as listed in TrueForge's model catalog: openai, anthropic, google, ...
MODEL_PROVIDER=
# The provider API key. File alternative: secrets/model_api_key
MODEL_API_KEY=
# Shortcut for MODEL_PROVIDER=openai. File alternative: secrets/openai_api_key
OPENAI_API_KEY=
# Optional. Pin one model by name; blank uses the first model TrueForge reports.
TRUEFORGE_MODEL=

# ----------------------------------------------------------------------------
# Optional enrichment providers — absent means the feature is skipped
# ----------------------------------------------------------------------------
# IPQualityScore phone reputation. Without it, phone checks fall back to local
# numbering-plan analysis and the report says reputation was not configured.
# File alternative: secrets/ipqs_api_key
IPQS_API_KEY=

# Daytona sandbox provider. Without it, the agent runs without an isolated
# sandbox and the UI reflects that. File alternative: secrets/daytona_api_key
DAYTONA_API_KEY=

# ----------------------------------------------------------------------------
# Agent behaviour — optional, sensible defaults
# ----------------------------------------------------------------------------
# auto enables a supported local or Daytona sandbox; false disables it.
TRUEFORGE_SANDBOX=auto
# Native identity/link investigators; false keeps coordinator-only execution.
TRUEFORGE_SUBAGENTS=true

# ----------------------------------------------------------------------------
# Local (non-Docker) runs only — Compose sets its own values for these
# ----------------------------------------------------------------------------
# Used by `npm run dev`. Compose overrides them with its internal service names,
# so changing them here has no effect on `docker compose up`.
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
MCP_HOST=127.0.0.1
MCP_PORT=8791
VERIFYFIRST_MCP_URL=http://127.0.0.1:8791/mcp
# Where case data is written. Blank uses the git-ignored .data/ directory.
VERIFYFIRST_DATA_DIR=
# Generated by `npm run setup` if absent. Compose creates its own in a private
# volume and ignores this value.
VERIFYFIRST_MCP_TOKEN=

# ----------------------------------------------------------------------------
# Advanced — explicit secret file paths
# ----------------------------------------------------------------------------
# Prefer dropping files in ./secrets/ (portable, no paths to maintain). Set one
# of these only to point at a file somewhere else, for example a mount your
# orchestrator provides. An explicit path that cannot be read is reported as an
# error rather than silently ignored.
#
# IPQS_API_KEY_FILE=
# MODEL_API_KEY_FILE=
# OPENAI_API_KEY_FILE=
# DAYTONA_API_KEY_FILE=
# TRUEFORGE_TOKEN_FILE=

# Optional hosted-TrueForge OIDC ID token; unused by the local Compose topology.
TRUEFORGE_TOKEN=
