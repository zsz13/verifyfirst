# VerifyFirst production configuration for compose.prod.yaml.
#
# On the server, copy this file to .env in the repository root (next to
# compose.prod.yaml) and lock it down:
#
#     cp .env.production.example .env && chmod 600 .env
#
# .env is git-ignored. Never commit it. Compose refuses to start if a REQUIRED value
# is empty and names the missing variable.
#
# Wrap any value containing $, # or spaces in single quotes, e.g. BASIC_AUTH_PASSWORD='a$b#c'.
# Compose would otherwise expand $NAME and treat " #" as a comment.

# ----------------------------------------------------------------------------
# REQUIRED
# ----------------------------------------------------------------------------
# The public hostname only: no https://, no path. Its DNS A record must point at
# this server before the first start, so Let's Encrypt can issue the certificate.
DOMAIN=

# Everyone who opens the site signs in with this username and password (HTTP Basic
# Auth in Nginx). VerifyFirst has no user accounts, so this is what keeps strangers
# from spending your model credit. Username must not contain ":". Password: at least
# 12 characters; generate one with `openssl rand -base64 18`.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# The AI model, registered in TrueForge automatically on every start: no TrueForge UI
# needed. Provider name as listed in TrueForge's model catalog: openai, anthropic,
# google, ... An unsupported name is reported in `docker compose logs setup`.
MODEL_PROVIDER=
MODEL_API_KEY=

# ----------------------------------------------------------------------------
# OPTIONAL — leave blank to use the default or skip the feature
# ----------------------------------------------------------------------------
# Let's Encrypt account contact. Blank registers without one; Let's Encrypt no longer
# sends expiry emails, and renewal is automatic.
LETSENCRYPT_EMAIL=
# Pin one model by its TrueForge name, e.g. openai/gpt-5-4-mini. Blank uses the first
# model the provider reports. A name that matches no model stops investigations, and
# the UI says so.
TRUEFORGE_MODEL=
# IPQualityScore phone reputation. Blank: phone checks use local numbering-plan
# analysis only, and the report says reputation was not configured.
IPQS_API_KEY=
# Daytona sandbox. Blank: the agent runs without an isolated sandbox and the UI says so.
DAYTONA_API_KEY=
# auto uses a Daytona sandbox when DAYTONA_API_KEY is set; false disables sandboxing.
# Setup adds and updates TrueForge settings but never removes them: after blanking
# DAYTONA_API_KEY set this to false, and after switching MODEL_PROVIDER set TRUEFORGE_MODEL.
TRUEFORGE_SANDBOX=auto
# Native identity/link investigators; false keeps coordinator-only execution.
TRUEFORGE_SUBAGENTS=true
